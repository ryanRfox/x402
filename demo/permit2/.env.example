# =============================================================================
# Permit2 Demo - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# SECURITY: Never commit .env files with real private keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Required for Testnets
# -----------------------------------------------------------------------------

# Your wallet private key (with 0x prefix)
# This account will be used as both payer and facilitator
PRIVATE_KEY=0x...

# -----------------------------------------------------------------------------
# Optional: Custom Token Configuration
# -----------------------------------------------------------------------------
# By default, the demo uses pre-deployed USDEMO tokens.
# Set these to use any ERC-20 token with Permit2.

# Token contract address (required to use a custom token)
# TOKEN_ADDRESS=0xYourTokenAddress

# Token symbol for display (default: "TOKEN" if TOKEN_ADDRESS is set)
# TOKEN_SYMBOL=USDC

# Token decimal places (default: 18 if TOKEN_ADDRESS is set)
# Most stablecoins use 6 decimals, most other tokens use 18
# TOKEN_DECIMALS=6

# -----------------------------------------------------------------------------
# Optional: Network RPC URLs
# -----------------------------------------------------------------------------
# Override default RPC endpoints if needed.

# Radius Staging (default: https://rpc.stg.tryradi.us)
# RADIUS_STAGING_RPC_URL=https://rpc.stg.tryradi.us

# Radius Testnet (default: https://rpc.testnet.tryradi.us)
# RADIUS_TESTNET_RPC_URL=https://rpc.testnet.tryradi.us

# =============================================================================
# Example: Using USDC on Base Sepolia
# =============================================================================
# PRIVATE_KEY=0x...
# TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# TOKEN_SYMBOL=USDC
# TOKEN_DECIMALS=6
