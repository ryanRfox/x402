# Required: payer / facilitator-relayer key (Mezo Testnet, funded with mUSD and BTC for gas)
EVM_PRIVATE_KEY=

# Optional: dedicated receiver authorizer EOA (signs ClaimBatch + Refund EIP-712 messages).
# Defaults to the EVM_PRIVATE_KEY if unset — fine for the demo.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Optional: receiver / payTo address. Defaults to the EVM_PRIVATE_KEY's address.
EVM_RECEIVER_ADDRESS=

# Optional: custom Mezo Testnet RPC URL. Defaults to https://rpc.test.mezo.org.
EVM_RPC_URL=

# Phase 5 finalize behaviour:
#   "false" (default) — initiate withdraw, demonstrate revert before delay, then exit.
#   "true"            — wait the full 900-second withdraw delay and finalize on-chain.
WAIT_FULL_WITHDRAW=false
