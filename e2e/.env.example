# E2E Test Environment Configuration
#
# This file demonstrates the network-override configuration system for E2E testing.
# The system allows you to maintain multiple network configurations in a single .env file
# and switch between them by changing only the EVM_NETWORK variable.

# ============================================================================
#  QUICK START: SWITCHING NETWORKS
# ============================================================================
#
# To switch between networks, follow these steps:
#
# 1. Set EVM_NETWORK at the top to your desired network:
#    - Base Sepolia:  EVM_NETWORK=eip155:84532 (default)
#    - Radius Testnet: EVM_NETWORK=eip155:1223953
#
# 2. Ensure configuration variables exist for that network:
#    - If using Base Sepolia (default): Use base variable names without suffix
#    - If using Radius Testnet: Use variable names with _1223953 suffix
#
# 3. Run your E2E tests - the configuration system will automatically resolve
#    the correct values based on EVM_NETWORK.
#
# EXAMPLE: To switch from Base Sepolia to Radius Testnet:
#   1. Change: EVM_NETWORK=eip155:84532
#      To:     EVM_NETWORK=eip155:1223953
#   2. Uncomment the "RADIUS TESTNET" section below
#   3. Run tests as normal
#
# ============================================================================

# ============ NETWORK SELECTION ============
# Set this to the desired network - all other configuration values will
# be automatically resolved based on this setting.
#
# Available values:
#   eip155:84532     = Base Sepolia (default)
#   eip155:1223953   = Radius Testnet
EVM_NETWORK=eip155:84532
SVM_NETWORK=solana-devnet

# ============ BASE SEPOLIA (Default - eip155:84532) ============
#
# This is the default network configuration. These values are used when:
# - EVM_NETWORK=eip155:84532
# - No network-specific overrides exist
#
# For this network, use base variable names (no suffix).

# Account Configuration
# Client: Account that initiates payments
# Facilitator: Account that settles payments on-chain (needs ETH for gas)
# Server: Account that receives payments
CLIENT_EVM_PRIVATE_KEY=0x148d11da374c17c691e9786edb9d003178fa9ae0438b30649de9b5f86f963634
CLIENT_SVM_PRIVATE_KEY=5RXwRKMW39BhZbinsp9FtPAG2KNQKBh18prv6smpXPXGLNTktXEHYC6NcZ9hJsauq5Qh5eimJR5gdKvDJ8bDmBS7
FACILITATOR_EVM_PRIVATE_KEY=0x148d11da374c17c691e9786edb9d003178fa9ae0438b30649de9b5f86f963634
FACILITATOR_SVM_PRIVATE_KEY=5RXwRKMW39BhZbinsp9FtPAG2KNQKBh18prv6smpXPXGLNTktXEHYC6NcZ9hJsauq5Qh5eimJR5gdKvDJ8bDmBS7
SERVER_EVM_ADDRESS=0xe154416a34acbc1d166b35f42d35a224e3a1f3b2
SERVER_SVM_ADDRESS=DummySolanaAddressNotUsedForEVMTests11111111111

# Network Configuration
# RPC endpoint for connecting to the blockchain
EVM_RPC_URL=https://sepolia.base.org

# Permit2 Token Configuration
# These values are used by the /protected-permit2 endpoint for payment verification
# On Base Sepolia, we use WETH (Wrapped Ether)
PERMIT2_TOKEN_ADDRESS=0x4200000000000000000000000000000000000006
PERMIT2_TOKEN_DECIMALS=18

# Settlement Contract Address
# This is the x402 Settlement contract that enforces trust-minimized payments
# See contracts/README.md for deployment details
X402_SETTLEMENT_ADDRESS=0x2539c506ee3f5A08886d3c1EADc0307DF8096A1b

# ============ RADIUS TESTNET (eip155:1223953) ============
#
# Network-specific override configuration for Radius Testnet.
# These variables use the _1223953 suffix to indicate they apply to chain ID 1223953.
#
# To use Radius Testnet:
# 1. Uncomment the variables below
# 2. Change EVM_NETWORK at the top to: eip155:1223953
#
# IMPORTANT: You can have different accounts on different networks!
# If your test accounts differ between networks, update the client/facilitator
# private keys below. If they're the same, you can comment them out and the
# system will fall back to the base CLIENT_EVM_PRIVATE_KEY value.

# Account Configuration for Radius (can be different from Base Sepolia)
# CLIENT_EVM_PRIVATE_KEY_1223953=0x...
# FACILITATOR_EVM_PRIVATE_KEY_1223953=0x...
# SERVER_EVM_ADDRESS_1223953=0xe154416a34acbc1d166b35f42d35a224e3a1f3b2

# Network Configuration for Radius
# EVM_RPC_URL_1223953=https://rpc.testnet.radiustech.xyz

# Permit2 Token Configuration for Radius
# Different token deployed on Radius testnet
# PERMIT2_TOKEN_ADDRESS_1223953=0xF966020a30946A64B39E2e243049036367590858
# PERMIT2_TOKEN_DECIMALS_1223953=18

# Settlement Contract Address for Radius
# X402_SETTLEMENT_ADDRESS_1223953=0x740C8fb1853F9ab61E405A30F3E9c9f41F4e65C6

# ============================================================================
#  NETWORK OVERRIDE SYSTEM DOCUMENTATION
# ============================================================================
#
# How the configuration resolution works:
#
# 1. The EVM_NETWORK variable at the top specifies the active network
# 2. The config system extracts the numeric chain ID (e.g., 1223953 from eip155:1223953)
# 3. For each configuration variable, it looks up values in this order:
#    a) Network-specific variable with suffix: VARIABLE_NAME_${CHAIN_ID}
#    b) Base variable without suffix: VARIABLE_NAME
#    c) Error if neither exists
#
# Example:
#   Given: EVM_NETWORK=eip155:1223953
#   When requesting: getNetworkConfigValue('EVM_RPC_URL')
#   Resolution:
#     - Check: EVM_RPC_URL_1223953 (if present, use it)
#     - Otherwise: Check EVM_RPC_URL (if present, use it)
#     - Otherwise: Throw error
#
# This allows you to:
# ✓ Use base values as defaults for all networks
# ✓ Override only the values that differ per network
# ✓ Add new networks by adding new _CHAIN_ID suffixed variables
# ✓ Keep a single source of truth for network selection (EVM_NETWORK)
#
# ============================================================================
#  PREREQUISITES FOR EACH NETWORK
# ============================================================================
#
# Base Sepolia (eip155:84532):
#   - CLIENT_EVM_PRIVATE_KEY account must have ETH to wrap as WETH
#   - Account must have approved Permit2 for WETH transfers
#   - FACILITATOR account must have ETH for gas
#
# Radius Testnet (eip155:1223953):
#   - Same requirements as Base Sepolia, but on Radius network
#   - Different token address (see example above)
#   - Different settlement contract address (see example above)
#
# ============================================================================
